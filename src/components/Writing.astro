---
import { site } from '../data/site';
import { getLatestPosts } from '../lib/substack';

const posts = await getLatestPosts(site.substack.feed, site.substack.postCount);
const substackUrl = site.links.find((link) => link.label === 'Substack')?.url;
---

<section aria-labelledby="writing-title">
  <h2 id="writing-title">Latest posts</h2>
  {
    posts.length > 0 ? (
      <ol>
        {posts.map((post) => (
          <li>
            <a href={post.url} target="_blank" rel="noopener">{post.title}</a>
            <time datetime={post.date.toISOString()}>{post.date.getFullYear()}</time>
          </li>
        ))}
      </ol>
    ) : (
      <p class="muted">Soon.</p>
    )
  }
  {substackUrl && <p><a href={substackUrl} target="_blank" rel="noopener">Subscribe on Substack</a></p>}
</section>

<style>
  ol {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.15rem 0;
  }
  li a {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  li a {
    text-decoration: none;
  }
  li a::before {
    content: '→ ';
    color: var(--muted);
  }
  time {
    flex: none;
    color: var(--muted);
  }
</style>
