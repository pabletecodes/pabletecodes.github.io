---
import { entries, groups, type Entry, type Position } from '../data/career';

// Everything shares one horizontal scale: from the first year to today.
const today = new Date();
const now = today.getFullYear() + today.getMonth() / 12;

const first = Math.floor(Math.min(...entries.flatMap((entry) => entry.positions.map((p) => p.start))));
const range = now - first;
const pct = (year: number) => `${((year - first) / range) * 100}%`;

const ticks: number[] = [];
// Skip a tick too close to the right edge, where its label would be clipped.
for (let year = first; year < now - 1.5; year += range > 16 ? 4 : 2) ticks.push(year);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = (entry: Entry) => `${entry.group}-${entry.name}`.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const yearSpan = (start: number, end: number | undefined, approx?: boolean) => {
  const from = Math.floor(start);
  const to = end === undefined ? 'now' : Math.floor(end - 0.01);
  return `${approx ? '~' : ''}${from === to ? from : `${from}–${to}`}`;
};
const month = (year: number) =>
  new Date(Math.floor(year), Math.round((year % 1) * 12)).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const positionSpan = (entry: Entry, p: Position) =>
  entry.approx ? yearSpan(p.start, p.end, true) : `${month(p.start)} – ${p.end === undefined ? 'now' : month(p.end - 1 / 12)}`;

// One row per position. Companies with several positions get a header row
// first, and their positions are listed under it, oldest first.
type Row =
  | { kind: 'company'; entry: Entry }
  | { kind: 'role'; entry: Entry; position: Position; id: string; single: boolean; last: boolean; stack?: string[] };

const rowsFor = (group: string): Row[] =>
  entries
    .filter((entry) => entry.group === group)
    .flatMap((entry) => {
      const single = entry.positions.length === 1;
      const roles: Row[] = entry.positions.map((position, i) => ({
        kind: 'role',
        entry,
        position,
        id: single ? slug(entry) : `${slug(entry)}-${i + 1}`,
        single,
        last: i === entry.positions.length - 1,
        stack: position.stack ?? (single ? entry.stack : undefined),
      }));
      return single ? roles : [{ kind: 'company', entry }, ...roles];
    });

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((word) => /^[A-Z]/.test(word))
    .slice(0, 2)
    .map((word) => word[0])
    .join('');
---

<section aria-labelledby="timeline-title" data-career data-first={first} data-end={now}>
  <h2 id="timeline-title">Timeline</h2>

  <div class="chart" tabindex="0" aria-label="Career timeline. Use up and down arrows or j and k to move between entries, left and right arrows to move through the years.">
    <div class="row axis" aria-hidden="true">
      <span></span>
      <div class="ticks">
        {ticks.map((year) => <span style={`left: ${pct(year)}`}>{year}</span>)}
      </div>
    </div>

    {
      groups.map((group) => (
        <div class="group">
          <h3>{group.label}</h3>
          <ul>
            {rowsFor(group.id).map((row) =>
              row.kind === 'company' ? (
                <li class="company" data-company={slug(row.entry)}>
                  <span class="name">{row.entry.name}</span>
                </li>
              ) : (
                <li data-company={slug(row.entry)} data-positions={JSON.stringify([[row.position.start, row.position.end ?? now]])}>
                  <button class:list={['row', { sub: !row.single }]} popovertarget={row.id}>
                    <span class="name">
                      {row.single ? (
                        <>
                          {row.entry.name}
                          <span class="role">{row.position.title}</span>
                        </>
                      ) : (
                        <span class="role">
                          <span class="tree" aria-hidden="true">{row.last ? '└─' : '├─'}</span>
                          {row.position.title}
                        </span>
                      )}
                    </span>
                    <span class="lane">
                      <span
                        class:list={['bar', { ongoing: row.position.end === undefined }]}
                        style={`left: ${pct(row.position.start)}; width: ${pct(first + (row.position.end ?? now) - row.position.start)}`}
                      />
                    </span>
                    <span class="years">{yearSpan(row.position.start, row.position.end, row.entry.approx)}</span>
                  </button>

                  <div class="card" id={row.id} popover>
                    <header>
                      {row.entry.logo ? (
                        <img class="logo" src={base + row.entry.logo} alt="" width="44" height="44" loading="lazy" />
                      ) : (
                        <span class="logo">{initials(row.entry.name)}</span>
                      )}
                      <div>
                        <strong>{row.entry.name}</strong>
                        {row.entry.context && <span>{row.entry.context}</span>}
                      </div>
                      <button class="close" popovertarget={row.id} popovertargetaction="hide" aria-label="Close">
                        ×
                      </button>
                    </header>
                    <strong>{row.position.title}</strong>
                    <p class="meta">
                      {positionSpan(row.entry, row.position)}
                      {row.position.location && ` · ${row.position.location}`}
                    </p>
                    {row.position.highlights && (
                      <ul class="highlights">
                        {row.position.highlights.map((item) => <li>{item}</li>)}
                      </ul>
                    )}
                    {row.stack && (
                      <ul class="stack">
                        {row.stack.map((item) => <li>{item}</li>)}
                      </ul>
                    )}
                    {row.entry.url && (
                      <a class="visit" href={row.entry.url}>
                        {new URL(row.entry.url).hostname.replace(/^www\./, '')} ↗
                      </a>
                    )}
                  </div>
                </li>
              ),
            )}
          </ul>
        </div>
      ))
    }

    <div class="cursor" hidden aria-hidden="true"><span></span></div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-career]')) {
    const first = Number(root.dataset.first);
    const end = Number(root.dataset.end);
    const chart = root.querySelector<HTMLElement>('.chart')!;
    const scale = root.querySelector<HTMLElement>('.ticks')!;
    const cursor = root.querySelector<HTMLElement>('.cursor')!;
    const rows = [...root.querySelectorAll<HTMLElement>('li[data-positions]')].map((el) => ({
      el,
      company: el.dataset.company!,
      positions: JSON.parse(el.dataset.positions!) as [number, number, string][],
    }));
    const headers = [...root.querySelectorAll<HTMLElement>('li.company')];
    let current: number | null = null;

    const show = (year: number) => {
      current = Math.min(Math.max(year, first), end);
      const box = scale.getBoundingClientRect();
      const left = box.left - chart.getBoundingClientRect().left + ((current - first) / (end - first)) * box.width;
      cursor.style.left = `${left}px`;
      cursor.firstElementChild!.textContent = String(Math.floor(current));
      cursor.hidden = false;
      chart.classList.add('scrubbing');

      for (const row of rows) {
        row.el.classList.toggle('active', row.positions.some(([start, stop]) => start <= current! && current! < stop));
      }
      for (const header of headers) {
        header.classList.toggle('active', rows.some((row) => row.company === header.dataset.company && row.el.classList.contains('active')));
      }
    };

    const hide = () => {
      current = null;
      cursor.hidden = true;
      chart.classList.remove('scrubbing');
      rows.forEach((row) => row.el.classList.remove('active'));
      headers.forEach((header) => header.classList.remove('active'));
    };

    chart.addEventListener('pointermove', (event) => {
      const box = scale.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right) return hide();
      show(first + ((event.clientX - box.left) / box.width) * (end - first));
    });
    chart.addEventListener('pointerleave', hide);
    // Keyboard: ↑/↓ or j/k move between entries, ←/→ or h/l move through
    // the years, Enter opens the focused entry (then j/k flip through cards). Focusing an entry also puts
    // the year cursor in the middle of it.
    const buttons = rows.map((row) => row.el.querySelector<HTMLButtonElement>('button.row')!);
    const step = (delta: number) => {
      const index = buttons.indexOf(document.activeElement as HTMLButtonElement);
      const next = index === -1 ? (delta > 0 ? 0 : buttons.length - 1) : index + delta;
      const button = buttons[Math.min(Math.max(next, 0), buttons.length - 1)];
      button.focus();
      // With a card open, j/k flip through the cards.
      const open = chart.querySelector<HTMLElement>('.card:popover-open');
      if (open && open !== button.nextElementSibling) {
        open.hidePopover();
        (button.nextElementSibling as HTMLElement).showPopover();
      }
    };

    buttons.forEach((button, i) =>
      button.addEventListener('focus', () => {
        const spans = rows[i].positions;
        show((spans[0][0] + spans[spans.length - 1][1]) / 2);
      }),
    );
    chart.addEventListener('focusout', (event) => {
      if (!chart.contains(event.relatedTarget as Node)) hide();
    });

    chart.addEventListener('keydown', (event) => {
      if ((event.target as Element).closest('.card') || event.metaKey || event.ctrlKey || event.altKey) return;
      const vertical = { ArrowDown: 1, j: 1, ArrowUp: -1, k: -1 }[event.key];
      const horizontal = { ArrowLeft: -1, h: -1, ArrowRight: 1, l: 1 }[event.key];
      if (event.key === 'Escape') return hide();
      if (vertical) {
        event.preventDefault();
        step(vertical);
      } else if (horizontal) {
        event.preventDefault();
        show((current === null ? end : Math.floor(current) + 0.5) + horizontal);
      }
    });

    // j/k also work from anywhere on the page, jumping into the timeline.
    document.addEventListener('keydown', (event) => {
      const target = event.target as Element;
      if (event.key !== 'j' && event.key !== 'k') return;
      if (chart.contains(target) || target.closest('input, textarea, [contenteditable], [popover]')) return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      event.preventDefault();
      buttons[event.key === 'j' ? 0 : buttons.length - 1].focus();
    });
  }
</script>

<style>
  [data-career] {
    --label: 19rem;
    --years: 7rem;
  }
  .chart {
    position: relative;
    outline: none;
    touch-action: pan-y;
  }
  .chart:focus-visible {
    outline: 1px dashed var(--muted);
    outline-offset: 0.75rem;
  }
  .row {
    display: grid;
    grid-template-columns: var(--label) 1fr var(--years);
    align-items: center;
  }

  .ticks {
    position: relative;
    height: 1.6em;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .ticks span {
    position: absolute;
    padding-left: 0.3rem;
    border-left: 1px solid var(--line);
  }

  .group {
    margin-top: 1.25rem;
  }
  h3 {
    margin: 0 0 0.2rem;
    color: var(--green);
    font-size: inherit;
    font-weight: normal;
  }
  h3::before {
    content: '## ';
    color: var(--muted);
  }
  .group > ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .group > ul > li {
    transition: opacity 120ms;
  }
  .scrubbing .group > ul > li:not(.active) {
    opacity: 0.3;
  }

  button.row {
    width: 100%;
    min-height: 2.1em;
    padding: 0.4rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  button.row:hover .name,
  button.row:focus-visible .name {
    color: var(--accent);
  }
  button.row {
    position: relative;
  }
  button.row:focus-visible {
    outline: none;
  }
  button.row:focus-visible::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: -1rem;
    width: 3px;
    background: var(--accent);
  }
  .name {
    padding-right: 1.5rem;
  }
  li.company {
    padding-top: 0.4rem;
  }
  .tree {
    flex: none;
    margin-right: 0.5em;
    color: var(--muted);
    opacity: 0.6;
  }
  button.sub .role {
    display: flex;
  }
  button.sub {
    padding: 0.15rem 0;
  }
  .role {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .lane {
    position: relative;
    height: 2.1em;
    background: linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat;
  }
  .bar {
    position: absolute;
    top: 50%;
    min-width: 0.6rem;
    height: 0.6rem;
    transform: translateY(-50%);
    background: var(--accent);
  }
  .bar + .bar {
    border-left: 2px solid var(--bg);
  }
  .bar.ongoing {
    background: linear-gradient(to right, var(--accent) 50%, transparent);
  }
  button.row:hover .bar {
    background: var(--text);
  }
  .years {
    color: var(--muted);
    text-align: right;
  }

  .cursor {
    position: absolute;
    top: 0.3rem;
    bottom: 0;
    border-left: 1px dashed var(--text);
    pointer-events: none;
  }
  .cursor span {
    position: absolute;
    top: -1.6rem;
    transform: translateX(-50%);
    padding: 0 0.3rem;
    background: var(--bg);
    font-size: 0.8rem;
  }

  /* Detail card: a native popover, centered, with light dismiss. */
  .card {
    width: min(40rem, calc(100vw - 2rem));
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding: 1.5rem;
    border: 1px solid var(--accent);
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }
  .card::backdrop {
    background: rgb(10 11 18 / 0.7);
  }
  .card header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .card header strong,
  .card header span {
    display: block;
  }
  .card header div span {
    color: var(--muted);
  }
  .logo {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 6px;
    box-sizing: border-box;
    background: #fff;
    color: var(--bg);
    font-weight: 700;
    object-fit: contain;
  }
  .close {
    align-self: start;
    padding: 0 0.4rem;
    border: 1px solid var(--line);
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .meta {
    margin-bottom: 0.5rem;
    color: var(--green);
    font-size: 0.85rem;
  }
  .highlights {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    list-style: '→ ';
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .stack li {
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .visit {
    color: var(--accent);
  }

  /* Narrow screens: bars sit under each label at full width. */
  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr auto;
    }
    .axis > span:first-child {
      display: none;
    }
    .ticks {
      grid-column: 1 / -1;
    }
    button.row {
      row-gap: 0.2rem;
      padding: 0.35rem 0;
    }
    .name {
      grid-row: 1;
      grid-column: 1;
    }
    .years {
      grid-row: 1;
      grid-column: 2;
    }
    .lane {
      grid-row: 2;
      grid-column: 1 / -1;
      height: 0.6rem;
    }
  }
</style>
